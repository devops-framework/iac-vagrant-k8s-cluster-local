vrrp_instance VI_1 {
    state MASTER
    interface eth1           # Thay bằng tên card mạng của bạn (dùng ip a để check)
    virtual_router_id 51
    priority 100
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass 1234       # Mật khẩu chung giữa các node LB
    }
    virtual_ipaddress {
        192.168.56.15       # Đây chính là VIP bạn muốn đặt
    }
}